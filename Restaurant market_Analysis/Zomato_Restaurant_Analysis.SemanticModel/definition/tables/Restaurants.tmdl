	column 'Safety Level'
		dataType: string
		lineageTag: 130ecfb9-53a5-4fd6-a629-7a39e554d4a7
		summarizeBy: none
		sourceColumn: Safety Level

	measure 'Total Restaurants' = COUNTROWS(Restaurants)
		formatString: #,0
		lineageTag: 482a4e92-592a-4251-b75f-07871a1dd9da

	measure 'Unique Brands' = DISTINCTCOUNT(Restaurants[Brand])
		formatString: #,0
		lineageTag: 6c033dcc-070d-4c0c-8730-0ef68712de98

	measure 'Cities Covered' = DISTINCTCOUNT(Restaurants[City])
		formatString: #,0
		lineageTag: feba9721-be7f-4169-8f1a-5a3952c2ec54

	measure 'Avg Rating' = AVERAGE(Restaurants[Rating])
		formatString: 0.00
		lineageTag: b1ee4cd3-f7f4-4ca9-85c3-d383f606ab71

	measure 'Highly Rated %' = DIVIDE(CALCULATE(COUNTROWS(Restaurants), Restaurants[Rating] >= 4), CALCULATE(COUNTROWS(Restaurants), Restaurants[Rating] <> BLANK()))
		formatString: 0.0%
		lineageTag: 0260ca0e-d9f6-4eb2-b478-5e5790bfaf9b

	measure 'Avg Price for One' = AVERAGE(Restaurants[Price for One])
		formatString: #,0
		lineageTag: dd55409c-52aa-4cf8-a59e-f5dd1f7c18de

	measure 'Avg Delivery Time (min)' = AVERAGE(Restaurants[Delivery Minutes])
		formatString: 0.0
		lineageTag: 08bb8a94-7599-42f1-a4a0-81adcbef121e

	measure 'Max Safety %' = DIVIDE(CALCULATE(COUNTROWS(Restaurants), Restaurants[Safety Level] = "Max Safety"), COUNTROWS(Restaurants))
		formatString: 0.0%
		lineageTag: 38268a4f-2ea2-43e7-a857-4a48e2adf811

	measure 'Top 10 Cities' = VAR r = RANKX(ALLSELECTED(Restaurants[City]), [Total Restaurants], , DESC, Dense) RETURN IF(r <= 10, [Total Restaurants])
		formatString: #,0
		lineageTag: 707d18b1-97db-41c2-9f33-6ec3b740f84c

	measure 'Top 15 Cities' = VAR r = RANKX(ALLSELECTED(Restaurants[City]), [Total Restaurants], , DESC, Dense) RETURN IF(r <= 15, [Total Restaurants])
		formatString: #,0
		lineageTag: db71d4ac-7a5f-40ed-bf93-a3a5b53f5ede

	measure 'Top 12 States' = VAR r = RANKX(ALLSELECTED(Restaurants[State]), [Total Restaurants], , DESC, Dense) RETURN IF(r <= 12, [Total Restaurants])
		formatString: #,0
		lineageTag: 27733aa2-d567-4665-8f93-4db983fb0eb3

	measure 'Priciest Cities (Avg Price)' = VAR t = FILTER(ALLSELECTED(Restaurants[City]), [Total Restaurants] >= 300) VAR r = RANKX(t, [Avg Price for One], , DESC, Dense) RETURN IF([Total Restaurants] >= 300 && r <= 15, [Avg Price for One])
		formatString: #,0
		lineageTag: cfbf8963-9d1a-41f5-92ba-f4992cdd9fdb

	measure 'Fastest Cities (Avg Min)' = VAR t = FILTER(ALLSELECTED(Restaurants[City]), [Total Restaurants] >= 300) VAR r = RANKX(t, [Avg Delivery Time (min)], , ASC, Dense) RETURN IF([Total Restaurants] >= 300 && r <= 12, [Avg Delivery Time (min)])
		formatString: 0.0
		lineageTag: 81bf8bac-aa1d-44fa-882d-d58b4574eeed

	measure 'Top 5 States' = VAR r = RANKX(ALLSELECTED(Restaurants[State]), [Total Restaurants], , DESC, Dense) RETURN IF(r <= 5, [Total Restaurants])
		formatString: #,0
		lineageTag: 8771d910-a2cd-44a1-adf5-8439485752d7

	measure 'Top 10 Cities Avg Rating' = IF(NOT ISBLANK([Top 10 Cities]), [Avg Rating])
		formatString: 0.00
		lineageTag: 8e5b9367-bc7d-4ecf-8473-32dda816a963

	measure 'Note Restaurants' = FORMAT(DIVIDE([Total Restaurants], CALCULATE([Total Restaurants], ALL(Restaurants))), "0.0%") & " of all listings"
		lineageTag: fcdc7ab0-4b62-49d2-ada6-807f6d2b7ba5

	measure 'Note Brands' = FORMAT(DIVIDE([Total Restaurants], [Unique Brands]), "0.0") & " outlets per brand"
		lineageTag: 2a7a5a16-4464-4329-bf9c-fde21b120bf7

	measure 'Note Cities' = FORMAT(DISTINCTCOUNT(Restaurants[State]), "0") & " states covered"
		lineageTag: e83b40f3-682e-4dbb-bc65-a5945e259365

	measure 'Note Rating' = VAR d = [Avg Rating] - CALCULATE([Avg Rating], ALL(Restaurants)) RETURN IF(d >= 0, "▲ ", "▼ ") & FORMAT(ABS(d), "0.00") & " vs India"
		lineageTag: 7452da27-09ba-47ae-bf9e-9a5e6ae17efe

	measure 'Note Highly Rated' = VAR d = ([Highly Rated %] - CALCULATE([Highly Rated %], ALL(Restaurants))) * 100 RETURN IF(d >= 0, "▲ ", "▼ ") & FORMAT(ABS(d), "0.0") & " pts vs India"
		lineageTag: 19b1cde9-9abc-4cba-941e-a967f516cd8e

	measure 'Note Price' = VAR d = [Avg Price for One] - CALCULATE([Avg Price for One], ALL(Restaurants)) RETURN IF(d >= 0, "▲ ₹", "▼ ₹") & FORMAT(ABS(d), "0") & " vs India"
		lineageTag: 43e32776-7b1f-4036-aeb6-d8eef20b6c4f

	measure 'Note Delivery' = VAR d = [Avg Delivery Time (min)] - CALCULATE([Avg Delivery Time (min)], ALL(Restaurants)) RETURN IF(d >= 0, "▲ ", "▼ ") & FORMAT(ABS(d), "0.0") & " min vs India"
		lineageTag: 363fce75-9836-43ca-8985-a46791bcd204

	measure 'Note Safety' = VAR d = ([Max Safety %] - CALCULATE([Max Safety %], ALL(Restaurants))) * 100 RETURN IF(d >= 0, "▲ ", "▼ ") & FORMAT(ABS(d), "0.0") & " pts vs India"
		lineageTag: f235ec5d-4885-46d7-82aa-6a10cc08cdaf

	measure 'Slowest Cities (Avg Min)' = VAR t = FILTER(ALLSELECTED(Restaurants[City]), [Total Restaurants] >= 300) VAR r = RANKX(t, [Avg Delivery Time (min)], , DESC, Dense) RETURN IF([Total Restaurants] >= 300 && r <= 12, [Avg Delivery Time (min)])
		formatString: 0.0
		lineageTag: d1c1f03b-59ab-4285-86d0-098ff9a7d26a

	partition Restaurants = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "restaurants.csv"), [Delimiter=",", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Restaurant ID", Int64.Type}, {"Restaurant Name", type text}, {"Brand", type text}, {"City", type text}, {"State", type text}, {"Region", type text}, {"Rating", type number}, {"Rating Status", type text}, {"Rating Band", type text}, {"Rating Band Order", Int64.Type}, {"Primary Cuisine", type text}, {"Cuisine Count", Int64.Type}, {"Price for One", type number}, {"Price Band", type text}, {"Price Band Order", Int64.Type}, {"Delivery Minutes", type number}, {"Delivery Speed", type text}, {"Delivery Speed Order", Int64.Type}, {"Delivery Status", type text}, {"Safety Level", type text}}, "en-US")
				in
				    Typed
